[sub_resource type="GDScript" id="GDScript_tuvbm"]
script/source = "extends Node2D

var won = false

func _process(_delta):
	if won:
		return
	var player = get_tree().current_scene.find_child(\"CharacterBody2D\", true, false)
	if player == null:
		print(\"Can't find CharacterBody2D\")
		return
	if player.global_position.distance_to(global_position) < 90.0:
		won = true
		show_win()

func show_win():
	var layer = CanvasLayer.new()
	layer.layer = 100
	get_tree().root.add_child(layer)

	var bg = ColorRect.new()
	bg.color = Color(0, 0, 0, 0.7)
	layer.add_child(bg)
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)

	var label = Label.new()
	label.text = \"YOU WIN!\"
	label.add_theme_font_size_override(\"font_size\", 90)
	label.add_theme_color_override(\"font_color\", Color.YELLOW)
	layer.add_child(label)
	label.set_anchors_preset(Control.PRESET_FULL_RECT)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
"

